---
import Brand from './Brand.astro';
import WhatsappLink from './WhatsappLink.astro';
---
<header class="header"><div class="container header-inner">
 <Brand />
 <button class="menu" type="button" aria-label="Abrir menú" aria-controls="df-nav" aria-expanded="false"><span aria-hidden="true">☰</span></button>
 <nav id="df-nav" aria-label="Navegación principal"><a href="#df-services">Especialidades</a><a href="#df-team">El equipo</a><a href="#df-clinic">Consultorio</a><a href="#df-contact">Contacto</a></nav>
 <div class="header-cta"><WhatsappLink>Consultar por WhatsApp</WhatsappLink></div>
</div></header>
<script>
const button=document.querySelector<HTMLButtonElement>('.menu');
const nav=document.querySelector<HTMLElement>('#df-nav');
if(button&&nav){
 const media=window.matchMedia('(max-width:1023px)');let open=false;
 const render=()=>{nav.hidden=media.matches&&!open;button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?'Cerrar menú':'Abrir menú');};
 const close=()=>{open=false;render();};
 button.addEventListener('click',()=>{open=!open;render();});
 nav.addEventListener('click',e=>{if((e.target as Element).closest('a')){const keyboard=(e as MouseEvent).detail===0;close();if(keyboard&&media.matches)button.focus();}});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&open){close();button.focus();}});
 document.addEventListener('click',e=>{if(open&&!(e.target as Element).closest('.header'))close();});
 media.addEventListener('change',close);render();
}
</script>
<style>
.header{position:sticky;top:0;z-index:20;background:var(--canvas);border-bottom:1px solid #e8dfd355;}
.header-inner{position:relative;display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:88px;}
nav{display:flex;align-items:center;gap:2px;border-radius:999px;background:var(--linen);padding:5px;}
nav a{display:flex;align-items:center;min-height:44px;padding:8px 12px;font-size:14px;border-radius:999px;}
nav a:hover{background:#ebe8e1;color:var(--navy);}
.menu{display:none;width:44px;height:44px;background:var(--navy);color:#fff;border:0;border-radius:50%;flex-shrink:0;}
@media(max-width:1120px){.header-cta :global(.df-button){padding-inline:16px;}nav a{padding-inline:9px;}}
@media(max-width:1023px){.menu{display:block;margin-left:auto;}.header-cta{display:none;}nav{position:absolute;inset:100% 0 auto;border-radius:0;padding:18px 24px;background:var(--canvas);border-bottom:1px solid var(--line);flex-direction:column;align-items:stretch;}nav a{padding:12px;} .header-inner{min-height:84px;}}
</style>
