---
import { whatsapp } from '../data/business';
import { Picture } from 'astro:assets';
import reception from '../assets/recepcion.png';
import childrenRoom from '../assets/consultorio.png';
import treatmentRoom from '../assets/consultorio-atencion.png';
const photos=[
 {src:reception,label:'Recepción',title:'Espacio cálido y luminoso',description:'La recepción de nuestro consultorio, con luz natural y un espacio para esperar.',alt:'Recepción con sillón blanco, pared turquesa y plantas'},
 {src:childrenRoom,label:'Espacio para las infancias',title:'Un rincón para los más chicos',description:'Juegos, libros y un mural de bosque acompañan el espacio de atención.',alt:'Consultorio con rincón infantil, libros y mural de bosque'},
 {src:treatmentRoom,label:'Consultorio odontológico',title:'Un espacio para tu atención',description:'Conocé el consultorio donde te recibimos en cada visita.',alt:'Consultorio con sillón odontológico naranja y escritorio'},
];
---
<section id="df-clinic" class="section clinic" aria-labelledby="clinic-title"><div class="container">
 <div class="section-heading"><div><span class="eyebrow">Nuestro consultorio</span><h2 id="clinic-title">Un espacio pensado para cuidar tu sonrisa.</h2></div><div class="clinic-location"><p>Gral. Las Heras / Marcos Paz</p><a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Consultá por tu próximo turno <span aria-hidden="true">↗</span><span class="sr-only"> (abre WhatsApp en otra pestaña)</span></a></div></div>
 <div class="clinic-gallery">{photos.map(photo=><figure><div class="photo-wrap"><Picture src={photo.src} formats={['avif','webp']} fallbackFormat="jpg" widths={[320,480,720]} sizes="(max-width:767px) calc(100vw - 72px), (max-width:1200px) calc((100vw - 160px) / 3), 325px" width={720} height={720} alt={photo.alt} loading="lazy" /><span class="photo-label">{photo.label}</span></div><figcaption><h3>{photo.title}</h3><p>{photo.description}</p></figcaption></figure>)}</div>
</div></section>
<style>
.clinic{background:var(--linen);}
.clinic-location{flex-shrink:0;font-size:14px;}
.clinic-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;}
figure{margin:0;padding:12px;background:#fff;border:1px solid var(--line);border-radius:12px;min-width:0;}
.photo-wrap{position:relative;}
.photo-wrap :global(img){display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;border-radius:7px;}
.photo-label{position:absolute;bottom:12px;left:12px;right:12px;width:fit-content;max-width:calc(100% - 24px);font-size:14px;background:var(--canvas);color:var(--navy);padding:5px 10px;border-radius:999px;}
figcaption{padding:20px 12px 16px;}
figcaption h3{font-size:25px;margin-bottom:10px;}
figcaption p{font-size:14px;}
@media(max-width:1023px){.section-heading{align-items:start;}.clinic-location{flex-shrink:1;}.clinic-gallery{gap:16px;}}
@media(max-width:767px){.clinic-gallery{grid-template-columns:1fr;gap:24px;}.clinic-location{margin-top:20px;}.photo-wrap :global(img){aspect-ratio:1;}}
</style>
