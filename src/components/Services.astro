---
import WhatsappLink from './WhatsappLink.astro';
import { Picture } from 'astro:assets';
import illustration from '../assets/limpieza-interdental.png';
const services=[
 {label:'Infancias',name:'Odontopediatría',description:'Cuidado de la salud bucal de las infancias.',doctor:'Od. Natalia Borlando',tone:'yellow'},
 {label:'Desarrollo',name:'Ortopedia maxilar',description:'Consultas sobre el desarrollo de los maxilares.',doctor:'Od. Natalia Borlando',tone:'sage'},
 {label:'Cuidado integral',name:'Odontología general',description:'Atención odontológica para cuidar tu sonrisa.',doctor:'Od. José Manuel Ispizua',tone:'neutral'},
 {label:'Rehabilitación',name:'Implantes dentales',description:'Consultá por la atención en implantes dentales.',doctor:'Od. José Manuel Ispizua',tone:'blue'},
 {label:'Alineación',name:'Ortodoncia',description:'Consultá por las opciones de atención en ortodoncia.',doctor:'Od. José Manuel Ispizua',tone:'neutral'},
];
---
<section id="df-services" class="section services"><div class="container">
 <div class="section-heading"><div><span class="eyebrow">Nuestras especialidades</span><h2>Cuidamos tu sonrisa en cada etapa.</h2></div><p>Conocé las áreas de atención de nuestro consultorio y el profesional a cargo.</p></div>
 <div class="service-grid">{services.map((item,index)=><article class="service-card"><div><div class="card-top"><span class:list={['tag',item.tone]}>{item.label}</span><span class="number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span></div><h3>{item.name}</h3><p>{item.description}</p></div><p class="doctor"><span aria-hidden="true">●</span>{item.doctor}</p></article>)}
 <article class="service-card question"><div><span class="question-mark" aria-hidden="true">?</span><h3>¿Tenés una duda puntual?</h3><p>Escribinos para conversar sobre tu consulta y coordinar un turno con nuestro equipo.</p></div><WhatsappLink variant="yellow">Escribinos al WhatsApp</WhatsappLink></article></div>
 <aside class="dental-tip" aria-labelledby="tip-title"><div><span class="tag yellow">Consejo de nuestro equipo</span><h3 id="tip-title">El cepillo no llega a todos los espacios. Por eso, necesitamos la <span class="highlight">limpieza interdental.</span></h3><p>El hilo o la cinta dental ayudan a eliminar la placa de los espacios interdentales. El cepillo limpia la superficie libre de los dientes.</p><p class="tip-consult">En tu consulta podemos conversar sobre el cuidado de tu sonrisa.</p></div><div class="tip-visual"><Picture src={illustration} formats={['avif','webp']} fallbackFormat="png" widths={[320,480,720]} sizes="(max-width:1023px) calc(100vw - 96px), 430px" width={720} height={480} loading="lazy" alt="Ilustración del hilo dental entre los dientes y un cepillo sobre su superficie" /><div class="tip-labels"><p><strong>El hilo dental</strong>Ayuda a limpiar los espacios interdentales.</p><p><strong>El cepillo</strong>Limpia la superficie libre de los dientes.</p></div></div></aside>
</div></section>
<style>
.services{background:var(--linen);}
.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;}
.service-card{display:flex;flex-direction:column;justify-content:space-between;gap:30px;padding:28px;background:#fff;border:1px solid var(--line);border-radius:12px;min-height:280px;}
.card-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px;}
.tag{display:inline-block;border-radius:999px;padding:5px 10px;font-size:14px;line-height:1.3;background:#ebe8e1;color:#44474e;}
.yellow{background:#fbf0c8;color:#54460c;}.sage{background:#d3e8da;color:#394b41;}.blue{background:#e2e9fa;color:#374667;}
.number{font:400 24px var(--serif);color:#687687;}
.service-card h3{margin-bottom:14px;}
.service-card p{font-size:16px;}
.service-card .doctor{display:flex;align-items:center;gap:8px;font-size:14px;}
.doctor span{font-size:8px;color:var(--gold);}
.question{background:var(--navy);color:#f4f0e9;border-color:var(--navy);align-items:start;}
.question h3{color:#fff;}
.question-mark{display:grid;place-items:center;width:38px;height:38px;border:1px solid #f7e29966;border-radius:50%;color:var(--yellow);margin-bottom:20px;font:24px var(--serif);}
.dental-tip{margin-top:56px;padding:40px;background:#fff;border:1px solid var(--line);border-radius:12px;display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center;}
.dental-tip h3{font-size:36px;margin:20px 0;}
.tip-consult{margin-top:20px;}
.tip-visual{background:var(--linen);padding:20px;border-radius:12px;}
.tip-visual :global(img){display:block;width:100%;height:auto;border-radius:8px;}
.tip-labels{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px;}
.tip-labels p{padding:12px;background:#fff;border-radius:6px;font-size:14px;}
.tip-labels strong{display:block;font-size:14px;font-weight:500;color:var(--gold);margin-bottom:5px;}
@media(max-width:1023px){.service-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.dental-tip{grid-template-columns:1fr;}.tip-visual{max-width:550px;width:100%;}}
@media(max-width:767px){.service-grid{grid-template-columns:1fr;}.service-card{min-height:0;padding:24px;}.dental-tip{padding:24px;gap:28px;margin-top:32px;}.dental-tip h3{font-size:30px;}.tip-visual{padding:12px;}.tip-labels{grid-template-columns:1fr;}}
</style>
