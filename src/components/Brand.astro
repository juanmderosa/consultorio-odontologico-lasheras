---
import { Picture } from 'astro:assets';
import logo from '../assets/logo.png';
---
<a href="#df-home" class="brand">
  <Picture src={logo} formats={['webp']} fallbackFormat="png" widths={[48,96]} sizes="44px" width={44} height={44} alt="" />
  <span><strong>Odontología Integral</strong><small>Las Heras · Consultorios</small></span>
</a>
<style>
.brand{display:inline-flex;align-items:center;gap:10px;flex-shrink:0;color:var(--navy);}
.brand :global(img){width:44px;height:44px;object-fit:contain;}
strong{display:block;font:400 23px/1.1 var(--serif);letter-spacing:-.02em;}
small{display:block;font-size:14px;letter-spacing:.07em;margin-top:4px;}
@media(max-width:480px){strong{font-size:19px;}small{font-size:14px;letter-spacing:0;}.brand{gap:8px;}.brand :global(img){width:36px;height:36px;}}
</style>
