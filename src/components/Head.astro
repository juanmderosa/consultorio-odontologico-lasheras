---
import { business } from "../data/business";
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const social = site ? new URL("/social.png", site).href : undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: business.name,
  telephone: `+${business.phone}`,
  ...(site ? { url: site.href, logo: new URL("/icon.png", site).href } : {}),
};
---

<meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1"
/>
<title>{business.title}</title>
<meta
  name="description"
  content={business.description}
/>
<meta
  name="robots"
  content={site ? "index, follow" : "noindex, nofollow"}
/>
<meta
  name="theme-color"
  content="#1b2b4a"
/>
<link
  rel="icon"
  type="image/png"
  href="/icon.png"
/>
<link
  rel="apple-touch-icon"
  href="/apple-touch-icon.png"
/>
{
  canonical && (
    <link
      rel="canonical"
      href={canonical}
    />
  )
}
<meta
  property="og:title"
  content={business.title}
/>
<meta
  property="og:description"
  content={business.description}
/>
<meta
  property="og:type"
  content="website"
/>
<meta
  property="og:site_name"
  content={business.name}
/>
<meta
  property="og:locale"
  content="es_AR"
/>
{
  canonical && (
    <meta
      property="og:url"
      content={canonical}
    />
  )
}
<meta
  name="twitter:card"
  content="summary_large_image"
/>
<meta
  name="twitter:title"
  content={business.title}
/>
<meta
  name="twitter:description"
  content={business.description}
/>
{
  social && (
    <>
      <meta
        property="og:image"
        content={social}
      />
      <meta
        property="og:image:width"
        content="1200"
      />
      <meta
        property="og:image:height"
        content="630"
      />
      <meta
        property="og:image:type"
        content="image/png"
      />
      <meta
        property="og:image:alt"
        content="Odontología Integral Las Heras. Natalia Borlando y José Manuel Ispizua."
      />
      <meta
        name="twitter:image"
        content={social}
      />
      <meta
        name="twitter:image:alt"
        content="Odontología Integral Las Heras. Natalia Borlando y José Manuel Ispizua."
      />
    </>
  )
}
<script
  type="application/ld+json"
  set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
/>
